# ---------------------------------------------------------------------------
# Repository-wide ignores.
#
# Patterns apply recursively from this directory, so this file covers both
# backend/ and frontend/. The per-package .gitignore files hold only what is
# genuinely specific to each.
#
# Note the deliberate absence of a *.sql rule: Prisma migrations under
# backend/database/prisma/migrations/ are .sql and MUST stay tracked — without
# them a fresh clone cannot build the database.
# ---------------------------------------------------------------------------

# Dependencies — restored with `npm install`, never committed.
node_modules/

# Build output — regenerated by `npm run build`.
dist/
build/

# Local environment. The .env.example templates are tracked on purpose; the
# real .env files hold live credentials and must not be.
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test/coverage output
coverage/

# Tooling caches
.vite/
.eslintcache
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
