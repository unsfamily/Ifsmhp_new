# ---------------------------------------------------------------------------
# IFSMHP Backend — environment template
#
# Copy to backend/.env and fill in. NEVER commit a real .env (spec §50).
# Only variables the application actually reads are listed; this file grows
# as milestones land.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# If the password contains URL-reserved characters it MUST be percent-encoded,
# or the driver silently reads an empty password.
DATABASE_URL="mysql://ifsmhp:ifsmhp@localhost:3306/ifsmhp"

# Optional, and only read by `npm run db:setup`. Give it a MySQL login that can
# CREATE DATABASE and CREATE USER (typically root) and setup will provision the
# database and the application user for you. Leave it unset if they already
# exist — setup skips that step and carries on. Never written to disk, and
# ignored entirely when NODE_ENV=production.
# ADMIN_DATABASE_URL="mysql://root:<root-password>@localhost:3306"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-random-character-secret"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=

# --- Uploads --------------------------------------------------------------
UPLOAD_STORAGE_PATH=./uploads
MAX_UPLOAD_MB=25

# --- Development seed account --------------------------------------------
SEED_ADMIN_EMAIL=admin@ifsmhp.local
SEED_ADMIN_PASSWORD=ChangeMeNow!2026

# --- Mail provider --------------------------------------------------------
# Delivers the one-time sign-in codes. Leave unset in development and the code
# is written to the server log instead; production requires a working transport.
# Never commit real credentials — this file is a template only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS="app-password-goes-here"
# Must match the authenticated account for most providers, Gmail included.
MAIL_FROM="IFSMHP <you@example.com>"

# Announcements: comma-separated SAB reviewer allowlist. Empty disables previews.
SAB_PREVIEW_EMAILS=
ANNOUNCEMENT_WORKER_ENABLED=true
# Public frontend origin used in notification and unsubscribe links.
ANNOUNCEMENT_WEB_URL=http://localhost:5173

# --- One-time passcodes ---------------------------------------------------
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
