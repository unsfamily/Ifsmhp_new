# ---------------------------------------------------------------------------
# IFSMHP Backend — environment template
#
# Copy to backend/.env and fill in. NEVER commit a real .env (spec §50).
# Only variables the application actually reads are listed; this file grows
# as milestones land.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# --- Database (Milestone 3) ----------------------------------------------
DATABASE_URL="postgresql://ifsmhp:ifsmhp@localhost:5432/ifsmhp?schema=public"

# --- Added in later milestones -------------------------------------------
# JWT_ACCESS_SECRET=        # M5 — generate with: openssl rand -base64 48
# JWT_REFRESH_SECRET=       # M5 — must differ from the access secret
# UPLOAD_STORAGE_PATH=./uploads   # M9
# SMTP_HOST=                # M15
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
