{
  "name": "ifsmhp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "IFSMHP platform — REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:exchange": "tsx scripts/test-document-exchange.ts",
    "test:watch": "vitest",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:bootstrap": "tsx scripts/bootstrap-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backfill-support": "tsx scripts/backfill-support.ts",
    "db:backfill-events": "tsx scripts/backfill-events.ts",
    "db:backfill-document-exchange": "tsx scripts/backfill-document-exchange.ts",
    "db:seed": "tsx database/prisma/seed.ts",
    "gallery:purge": "tsx scripts/purge-gallery-files.ts",
    "test:gallery:browser": "node tests/gallery.browser.cjs",
    "db:studio": "prisma studio",
    "test:community:browser": "node tests/community.browser.cjs",
    "test:moderation:browser": "node tests/community-moderation.browser.cjs",
    "test:audit:browser": "node tests/audit.browser.cjs",
    "test:profile:browser": "node tests/admin-profile.browser.cjs",
    "db:initialize-settings": "tsx scripts/initialize-settings.ts",
    "test:settings:browser": "node tests/settings.browser.cjs",
    "test:member-phone:browser": "node tests/member-phone.browser.cjs",
    "test:project-timeline:browser": "node tests/project-timeline.browser.cjs",
    "test:chat-attachments:browser": "node tests/chat-attachments.browser.cjs",
    "test:member-status:browser": "node tests/community-member-status.browser.cjs",
    "test:community-session:browser": "node tests/community-session.browser.cjs"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.2",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.0.6",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "playwright": "^1.63.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
